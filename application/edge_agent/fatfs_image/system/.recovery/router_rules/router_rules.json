[
  {
    "id": "im_session_command",
    "description": "Handle persistent chat session commands when the user sends /session.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} session command handled",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text",
      "text": "/session",
      "text_match_rule": "prefix"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "session_command",
        "input": {
          "command": "{{match.remainder}}"
        }
      },
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}"
        }
      }
    ]
  },
  {
    "id": "im_llm_command",
    "description": "Handle LLM configuration commands when the user sends /llm.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} LLM command handled",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text",
      "text": "/llm",
      "text_match_rule": "prefix"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "llm_config_command",
        "input": {
          "command": "{{match.remainder}}"
        }
      },
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}"
        }
      }
    ]
  },
  {
    "id": "im_cost_command",
    "description": "Report cumulative LLM token usage and approximate cost when the user sends /cost.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} cost command handled",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text",
      "text": "/cost",
      "text_match_rule": "prefix"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "cost_usage",
        "input": {}
      },
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}"
        }
      }
    ]
  },
  {
    "id": "im_any_message_working_reply",
    "description": "Deprecated: superseded by claw_core's own immediate agent_stage ack (published in claw_core_agent_loop.c), which is ephemeral and auto-deletes on the real reply. Kept disabled for reference.",
    "enabled": false,
    "consume_on_match": false,
    "ack": "{{event.source_channel}} working reply sent",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text"
    },
    "actions": [
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}",
          "message": "🐙 KrakBot Nano ya se está ocupando..."
        }
      }
    ]
  },
  {
    "id": "im_audio_attachment_transcribe",
    "description": "Transcribe inbound voice/audio attachments via Groq and route the text to the agent.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} audio attachment sent for transcription",
    "match": {
      "event_type": "attachment_saved",
      "content_type": "audio"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "groq_transcribe",
        "input": {
          "saved_path": "{{event.payload.saved_path}}",
          "chat_id": "{{event.chat_id}}",
          "channel": "{{event.source_channel}}",
          "sender_id": "{{event.sender_id}}",
          "message_id": "{{event.message_id}}"
        }
      }
    ]
  },
  {
    "id": "im_image_attachment_inspect",
    "description": "Analyze inbound image attachments via the vision-capable LLM and route the description to the agent.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} image attachment sent for analysis",
    "match": {
      "event_type": "attachment_saved",
      "content_type": "image"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "inspect_image",
        "input": {
          "path": "{{event.payload.saved_path}}",
          "prompt": "Describí brevemente esta imagen. Si algo de lo que se ve parece valioso para recordar sobre el usuario o el contexto (una preferencia, un documento, un lugar, un objeto importante), mencionalo explícitamente para poder guardarlo en la memoria.",
          "chat_id": "{{event.chat_id}}",
          "channel": "{{event.source_channel}}",
          "sender_id": "{{event.sender_id}}",
          "message_id": "{{event.message_id}}",
          "delete_after": true
        }
      }
    ]
  },
  {
    "id": "im_document_attachment_inspect",
    "description": "Process inbound document attachments (PDF summary, text passthrough, or an honest unsupported notice) and route the result to the agent.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} document attachment sent for analysis",
    "match": {
      "event_type": "attachment_saved",
      "content_type": "file"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "inspect_document",
        "input": {
          "path": "{{event.payload.saved_path}}",
          "original_filename": "{{event.payload.original_filename}}",
          "chat_id": "{{event.chat_id}}",
          "channel": "{{event.source_channel}}",
          "sender_id": "{{event.sender_id}}",
          "message_id": "{{event.message_id}}"
        }
      }
    ]
  },
  {
    "id": "im_attachment_saved_reply",
    "description": "Reply when an IM attachment is saved.",
    "enabled": true,
    "ack": "{{event.channel}} attachment saved",
    "match": {
      "event_type": "attachment_saved"
    },
    "actions": [
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}",
          "message": "File received from {{event.source_channel}}"
        }
      }
    ]
  },
