[
  {
    "id": "im_session_command",
    "description": "Handle persistent chat session commands when the user sends /session.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} session command handled",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text",
      "text": "/session",
      "text_match_rule": "prefix"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "session_command",
        "input": {
          "command": "{{match.remainder}}"
        }
      },
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}"
        }
      }
    ]
  },
  {
    "id": "im_llm_command",
    "description": "Handle LLM configuration commands when the user sends /llm.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} LLM command handled",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text",
      "text": "/llm",
      "text_match_rule": "prefix"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "llm_config_command",
        "input": {
          "command": "{{match.remainder}}"
        }
      },
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}"
        }
      }
    ]
  },
  {
    "id": "im_cost_command",
    "description": "Report cumulative LLM token usage and approximate cost when the user sends /cost.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} cost command handled",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text",
      "text": "/cost",
      "text_match_rule": "prefix"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "cost_usage",
        "input": {}
      },
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}"
        }
      }
    ]
  },
  {
    "id": "im_any_message_working_reply",
    "description": "Deprecated: superseded by claw_core's own immediate agent_stage ack (published in claw_core_agent_loop.c), which is ephemeral and auto-deletes on the real reply. Kept disabled for reference.",
    "enabled": false,
    "consume_on_match": false,
    "ack": "{{event.source_channel}} working reply sent",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text"
    },
    "actions": [
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}",
          "message": "🐙 KrakBot Nano ya se está ocupando..."
        }
      }
    ]
  },
  {
    "id": "im_audio_attachment_transcribe",
    "description": "Transcribe inbound voice/audio attachments via Groq and route the text to the agent.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} audio attachment sent for transcription",
    "match": {
      "event_type": "attachment_saved",
      "content_type": "audio"
    },
    "actions": [
      {
        "type": "call_cap",
        "cap": "groq_transcribe",
        "input": {
          "saved_path": "{{event.payload.saved_path}}",
          "chat_id": "{{event.chat_id}}",
          "channel": "{{event.source_channel}}",
          "sender_id": "{{event.sender_id}}",
          "message_id": "{{event.message_id}}"
        }
      }
    ]
  },
  {
    "id": "im_attachment_saved_reply",
    "description": "Reply when an IM attachment is saved.",
    "enabled": true,
    "ack": "{{event.channel}} attachment saved",
    "match": {
      "event_type": "attachment_saved"
    },
    "actions": [
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}",
          "message": "File received from {{event.source_channel}}"
        }
      }
    ]
  },
  {
    "id": "im_any_message_agent",
    "description": "Route IM text messages to the agent.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} routed to agent",
    "match": {
      "event_type": "message",
      "event_key": "text",
      "content_type": "text"
    },
    "actions": [
      {
        "type": "run_agent",
        "input": {
          "target_channel": "{{event.source_channel}}",
          "session_policy": "chat"
        }
      }
    ]
  },
  {
    "id": "agent_stage_im_notify",
    "description": "Deliver agent stage progress messages to the original IM chat.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} agent stage sent",
    "match": {
      "source_cap": "claw_core",
      "event_type": "agent_stage",
      "content_type": "text"
    },
    "actions": [
      {
        "type": "send_message",
        "input": {
          "event_type": "{{event.event_type}}",
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}",
          "message": "{{event.text}}"
        }
      }
    ]
  },
  {
    "id": "agent_out_message_send_message",
    "description": "Deliver agent output messages to the original IM chat.",
    "enabled": true,
    "consume_on_match": true,
    "ack": "{{event.source_channel}} agent output sent",
    "match": {
      "source_cap": "claw_core",
      "event_type": "out_message",
      "content_type": "text"
    },
    "actions": [
      {
        "type": "send_message",
        "input": {
          "channel": "{{event.source_channel}}",
          "chat_id": "{{event.chat_id}}",
          "message": "{{event.text}}"
        }
      }
    ]
  }
]
